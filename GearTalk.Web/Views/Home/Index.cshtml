@model List<GearTalk.Web.Models.Domain.CarReview>

@{
    ViewData["Title"] = "Home Page";
}

<section style="position:relative; width:100%; min-height:60vh; background:#0a0a0a; display:flex; align-items:center; overflow:hidden; font-family:'DM Sans',sans-serif;">

    <div style="position:absolute; inset:0; background:url('https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg') center/cover no-repeat; opacity:0.6; animation:slowZoom 20s ease-in-out infinite alternate;"></div>

    <div style="position:absolute; inset:0; background:linear-gradient(105deg, rgba(0,0,0,0.65) 40%, rgba(0,0,0,0.2) 100%);"></div>

    <div style="position:absolute; bottom:0; left:0; width:100%; height:4px; background:linear-gradient(90deg, #38bdf8, #7dd3fc, transparent);"></div>

    <div style="position:relative; z-index:2; padding:0 6vw; max-width:720px; animation:fadeUp 0.9s ease both;">

        <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(56,189,248,0.15); border:1px solid rgba(56,189,248,0.4); color:#38bdf8; font-size:11px; font-weight:500; letter-spacing:2.5px; text-transform:uppercase; padding:6px 14px; border-radius:2px; margin-bottom:28px;">
            <span style="width:6px; height:6px; border-radius:50%; background:#38bdf8; display:inline-block; animation:pulse 1.5s infinite;"></span>
            Independent Car Reviews
        </div>

        <h1 style="font-family:'Bebas Neue',sans-serif; font-size:clamp(72px,11vw,130px); line-height:0.95; color:#ffffff; letter-spacing:1px; margin-bottom:24px;">
            Gear<span style="color:#38bdf8; display:block;">Talk</span>
        </h1>

        <p style="font-size:16px; font-weight:300; color:rgba(255,255,255,0.6); line-height:1.8; max-width:480px; margin-bottom:40px;">
            Honest, technical, and real-world car reviews by a mechanical engineer.
            No sponsorships. No fluff. Just the truth about your next car.
        </p>

        <div style="display:flex; gap:16px; flex-wrap:wrap;">
            <a href="#reviews"
               style="background:#38bdf8; color:#0a0a0a; border:none; padding:14px 32px; font-size:14px; font-weight:600; letter-spacing:0.5px; border-radius:2px; text-decoration:none; display:inline-block;">
                Browse Reviews
            </a>
            <a href="https://www.youtube.com/channel/UCKMzbyQERTZSqbt1Ci3SL9w" target="_blank"
               style="background:transparent; color:rgba(255,255,255,0.8); border:1px solid rgba(255,255,255,0.25); padding:14px 32px; font-size:14px; font-weight:400; border-radius:2px; text-decoration:none; display:inline-block;">
                Watch on YouTube
            </a>
        </div>
    </div>

    <div style="position:absolute; bottom:48px; right:6vw; display:flex; gap:40px; z-index:2; display:none;" class="d-none d-md-flex">
        <div style="text-align:right;">
            <div style="font-family:'Bebas Neue',sans-serif; font-size:38px; color:#fff; line-height:1;">100%</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.4); letter-spacing:1.5px; text-transform:uppercase; margin-top:4px;">Independent</div>
        </div>
        <div style="width:1px; background:rgba(255,255,255,0.12);"></div>
        <div style="text-align:right;">
            <div style="font-family:'Bebas Neue',sans-serif; font-size:38px; color:#fff; line-height:1;">HD</div>
            <div style="font-size:11px; color:rgba(255,255,255,0.4); letter-spacing:1.5px; text-transform:uppercase; margin-top:4px;">Video Reviews</div>
        </div>
    </div>

    <div style="position:absolute; bottom:48px; left:6vw; display:flex; align-items:center; gap:12px; color:rgba(255,255,255,0.3); font-size:11px; letter-spacing:2px; text-transform:uppercase; z-index:2;" class="d-none d-md-flex">
        <div style="width:40px; height:1px; background:rgba(255,255,255,0.2);"></div>
        Scroll to explore
    </div>
</section>

<style>
    @@keyframes slowZoom {
        from {
            transform: scale(1.05);
        }

        to {
            transform: scale(1.12);
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(32px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }
</style>

<div id="reviews" class="container-fluid px-5 py-5">
    <h2 class="mb-4 fw-bold">Latest Reviews</h2>
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var review in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="review-card p-3 shadow-sm bg-light h-100 rounded">

                        <img src="@review.FeaturedImageUrl"
                             alt="@review.ModelName"
                             class="mb-3 rounded img-fluid" />

                        <h2 class="mb-4">@review.ModelName</h2>

                        <p class="mb-4">
                            Author: @review.Author
                            <br />
                            Published Date: @review.PublishedDate.ToShortDateString()
                        </p>
                        <p class="mb-4">
                            <span class="badge bg-secondary me-1">@review.category.Name</span>
                        </p>
                        <p class="mb-4">@review.ShortDescription</p>
                        <p class="mb-4">
                            <a href="@review.YouTubeVideoUrl" target="_blank" rel="noopener noreferrer">
                                ▶ Watch the full review on YouTube
                            </a>
                        </p>
                        <a class="btn btn-dark"
                           asp-area=""
                           asp-controller="CarReview"
                           asp-action="Index"
                           asp-route-urlHandle="@review.UrlHandle">Read More</a>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No reviews found.</p>
        }
    </div>
</div>